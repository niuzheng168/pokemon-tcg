{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pokemon-tcg:field-return:1.0.0",
  "type": "object", "additionalProperties": false,
  "required": ["op", "side", "target", "selector", "quantity", "to", "attachments", "chooser"],
  "properties": {
    "op": { "const": "returnPokemon" }, "side": { "enum": ["own", "opponent"] },
    "target": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/target" },
    "selector": { "$ref": "urn:pokemon-tcg:energy-mechanics:1.0.0#/$defs/pokemonSelector" },
    "quantity": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/cardQuantity" },
    "to": { "enum": ["hand", "deckShuffle", "discard", "lost"],
      "description": "discard: 「将…宝可梦，以及放于其身上的所有卡牌，放于弃牌区」 (II.C-01): every card to its owner's discard pile, not a Knock Out. lost: 「…放于放逐区」 (zones.lost-zone), its Pokémon cards, and with attachments return every card." },
    "attachments": { "enum": ["return", "discard"] },
    "chooser": { "enum": ["source", "holder"] },
    "promotion": {
      "description": "Explicit reviewed scheduling, not a claim that KO promotion order also applies to non-KO departure. Absent exactly when only Benched Pokémon can leave (target bench): the Active is never vacated. afterRelatedResolution is the ruled schedule (effects.field-return-promotion); sourceOfTruth is this card's own evidence (a card-library record only on a machine definition).",
      "type": "object", "additionalProperties": false, "required": ["timing", "sourceOfTruth"],
      "properties": {
        "timing": { "enum": ["afterAction", "afterRelatedResolution", "needsRuling"] },
        "sourceOfTruth": { "$ref": "urn:pokemon-tcg:card-definition:1.0.0#/$defs/cardEvidenceList" }
      }
    }
  },
  "allOf": [{
    "if": { "properties": { "to": { "const": "discard" } } },
    "then": { "properties": { "attachments": { "const": "discard" } } }
  }, {
    "if": { "properties": { "target": { "const": "bench" } } },
    "then": { "not": { "required": ["promotion"], "properties": { "promotion": {} } } },
    "else": { "required": ["promotion"], "properties": { "promotion": {} } }
  }]
}
