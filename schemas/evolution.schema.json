{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pokemon-tcg:evolution:1.0.0",
  "title": "Reviewed evolution, top-down devolution and explicitly inherited replacement",
  "$defs": {
    "pokemonSelector": { "$ref": "urn:pokemon-tcg:energy-mechanics:1.0.0#/$defs/pokemonSelector" },
    "timing": {
      "type": "object", "additionalProperties": false,
      "required": ["firstOwnTurn", "enteredThisTurn", "evolvedThisTurn"],
      "properties": {
        "firstOwnTurn": { "enum": ["allow", "forbid"] },
        "enteredThisTurn": { "enum": ["allow", "forbid"] },
        "evolvedThisTurn": { "enum": ["allow", "forbid", "needsRuling"] }
      }
    },
    "evolve": {
      "type": "object", "additionalProperties": false,
      "required": ["op", "target", "targetSelector", "from", "selector", "relation", "timing", "shuffleAfter"],
      "properties": {
        "op": { "const": "evolvePokemon" },
        "target": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/target" },
        "targetSelector": { "$ref": "#/$defs/pokemonSelector" },
        "from": { "enum": ["hand", "deck", "discard"] }, "selector": { "$ref": "#/$defs/pokemonSelector" },
        "relation": { "enum": ["ordinary", "skipStage1", "anyStage1"] },
        "timing": { "$ref": "#/$defs/timing" }, "shuffleAfter": { "type": "boolean" },
        "each": { "const": true, "description": "「选择自己牌库中从自己所有备战宝可梦进化而来的卡牌各1张，分别放于各只宝可梦身上进行进化」: every target is searched for once (each may fail to find); all cards are chosen before any Pokémon evolves, then the deck is shuffled once." },
        "count": { "type": "integer", "minimum": 1, "maximum": 8, "description": "With each: 「选择自己最多N只备战宝可梦，从自己牌库中选择从该宝可梦进化而来的卡牌各1张，各放于其身上进行进化」: the user first chooses 1 to N of the targets." }
      },
      "allOf": [{
        "if": { "properties": { "from": { "const": "deck" } } },
        "then": { "properties": { "shuffleAfter": { "const": true } } },
        "else": { "properties": { "shuffleAfter": { "const": false } } }
      }, {
        "if": { "required": ["each"], "properties": { "each": {} } },
        "then": { "properties": { "from": { "const": "deck" } } }
      }, {
        "if": { "required": ["count"], "properties": { "count": {} } },
        "then": { "required": ["each"], "properties": { "each": {} } }
      }]
    },
    "devolve": {
      "type": "object", "additionalProperties": false,
      "required": ["op", "side", "target", "targetSelector", "selection", "layers", "to", "chooser"],
      "properties": {
        "op": { "const": "devolvePokemon" },
        "side": { "enum": ["own", "opponent"] },
        "target": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/target" },
        "targetSelector": { "$ref": "#/$defs/pokemonSelector" },
        "selection": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/damageSelection" },
        "layers": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/cardQuantity" },
        "to": { "enum": ["hand", "discard", "deckShuffle"] }, "chooser": { "enum": ["source", "holder"] }
      }
    },
    "inherit": {
      "type": "object", "additionalProperties": false,
      "required": ["op", "target", "targetSelector", "from", "selector", "relation", "to"],
      "properties": {
        "op": { "const": "inheritPokemon" },
        "target": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/target" },
        "targetSelector": { "$ref": "#/$defs/pokemonSelector" },
        "from": { "enum": ["hand", "discard", "deck"] }, "selector": { "$ref": "#/$defs/pokemonSelector" },
        "relation": { "enum": ["any", "sameName"] }, "to": { "enum": ["hand", "discard", "deckShuffle"] }
      },
      "description": "deck/deckShuffle = 「选择自己牌库中的1张「X」，与这张卡牌互换（继承…）。如果互换了的话，则将这张卡牌放回牌库，并重洗牌库」: always both, then the deck is shuffled.",
      "allOf": [{ "if": { "properties": { "from": { "const": "deck" } } }, "then": { "properties": { "to": { "const": "deckShuffle" } } },
        "else": { "properties": { "to": { "enum": ["hand", "discard"] } } } }]
    },
    "replace": {
      "description": "Printed 「将这只宝可梦，以及放于其身上的所有卡牌放于弃牌区，将被选择的宝可梦放于这只宝可梦原先的位置」: a deck card becomes a NEW Pokémon in the same spot (II.E-12, II.C-13); nothing carries over and it is not a Knock Out (I.D).",
      "type": "object", "additionalProperties": false,
      "required": ["op", "target", "from", "selector", "shuffleAfter"],
      "properties": {
        "op": { "const": "replacePokemon" }, "target": { "const": "self" },
        "from": { "enum": ["deck", "discard"], "description": "discard = 「选择自己弃牌区中的1张…宝可梦。然后，…将被选择的宝可梦放于这只宝可梦原先的位置」: chosen from the public discard pile first; no shuffle." },
        "selector": { "$ref": "#/$defs/pokemonSelector" }, "shuffleAfter": { "type": "boolean" },
        "to": { "const": "lost", "description": "「将这只宝可梦，以及放于其身上的所有卡牌，放于放逐区」: every card of the replaced Pokémon to its owner's Lost Zone instead of the discard pile." }
      },
      "allOf": [{ "if": { "properties": { "from": { "const": "deck" } } }, "then": { "properties": { "shuffleAfter": { "const": true } } },
        "else": { "properties": { "shuffleAfter": { "const": false } } } }]
    },
    "transition": {
      "type": "object", "additionalProperties": false, "required": ["pokemonId", "topCardId"],
      "properties": {
        "pokemonId": { "type": "string", "minLength": 1 }, "topCardId": { "type": "string", "minLength": 1 }
      }
    },
    "evolutionPlan": {
      "description": "One entry per target in field order; cardId absent = not searched yet, null = none chosen.",
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false, "required": ["pokemonId", "topCardId"],
        "properties": {
          "pokemonId": { "type": "string", "minLength": 1 }, "topCardId": { "type": "string", "minLength": 1 },
          "cardId": { "type": ["string", "null"], "minLength": 1 }
        }
      }
    },
    "devolutionPlan": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false, "required": ["pokemonId", "topCardId", "count"],
        "properties": {
          "pokemonId": { "type": "string", "minLength": 1 }, "topCardId": { "type": "string", "minLength": 1 },
          "count": { "type": ["integer", "null"], "minimum": 0, "maximum": 59 }
        }
      }
    }
  }
}
