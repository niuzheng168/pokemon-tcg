{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pokemon-tcg:attack-copy:1.0.0",
  "$defs": {
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["instanceId", "attackId"],
      "properties": {
        "instanceId": { "type": "string", "minLength": 1 }, "attackId": { "type": "string", "minLength": 1 }
      }
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["op", "origins", "excludeUser", "coin", "energy", "special"],
      "properties": {
        "op": { "const": "copyAttack" },
        "origins": { "type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["side", "zone", "selector"],
          "properties": {
            "side": { "enum": ["own", "opponent", "either"] },
            "zone": { "enum": ["field", "active", "bench", "discard", "evolution", "previousTurn", "deck"],
              "description": "previousTurn (side opponent only): 「在上一个对手的回合，如果对手的宝可梦使用了招式…，则将该招式作为这个招式使用」, each attack the opponent's Pokémon actually used during the user's latest opponent turn (the declared attack, a Tool's attack included); the selector reads the attacking Pokémon's printed top card then. deck (with lookTop, the only origin): 「将对手牌库上方10张卡牌翻到正面。…选择其中的宝可梦所拥有的1个招式，作为这个招式使用。将翻到正面的卡牌放回牌库并重洗牌库」, the Pokémon cards among the top lookTop cards turned face up (all when fewer); they go back and that deck is shuffled before the chosen attack is used." },
            "lookTop": { "type": "integer", "minimum": 1, "maximum": 60 },
            "subject": { "const": "user" },
            "selector": { "$ref": "urn:pokemon-tcg:energy-mechanics:1.0.0#/$defs/pokemonSelector" }
          },
          "allOf": [{
            "if": { "required": ["subject"], "properties": { "subject": {} } },
            "then": { "properties": { "zone": { "enum": ["field", "active", "bench", "evolution"] } } }
          }, {
            "if": { "properties": { "zone": { "const": "previousTurn" } } },
            "then": { "properties": { "side": { "const": "opponent" } } }
          }, {
            "if": { "properties": { "zone": { "const": "deck" } } },
            "then": { "required": ["lookTop"], "properties": { "lookTop": {}, "side": { "enum": ["own", "opponent"] } }, "not": { "required": ["subject"], "properties": { "subject": {} } } },
            "else": { "not": { "required": ["lookTop"], "properties": { "lookTop": {} } } }
          }]
        } },
        "excludeUser": { "type": "boolean" }, "coin": { "enum": ["none", "heads", "tails"] },
        "optional": { "const": true,
          "description": "「若希望，可以选择其中的宝可梦所拥有的1个招式，作为这个招式使用」 (a deck origin only): the user may choose none (II.E-10)." },
        "chooser": { "const": "opponent",
          "description": "「对手选择对手自己场上的宝可梦所拥有的1个招式。将被选择的招式作为这个招式使用」: the opponent chooses among the opponent's own candidates." },
        "energy": { "enum": ["ignore", "printed", "effective"] },
        "attackIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "excludeSpecialRules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["GX", "VSTAR"] },
          "description": "「选择该宝可梦所拥有的1个招式（除GX招式外）」: no attack with this special rule can be chosen." },
        "among": {
          "description": "「…那只宝可梦所拥有的1个招式」 after a thenMoved: only the cards its first part actually moved, wherever they are now (a program writes \"moved\"; the host binds the actual cards). Never in handler parameters.",
          "oneOf": [{ "const": "moved" }, { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }]
        },
        "special": {
          "type": "object", "additionalProperties": false, "required": ["mode", "sourceOfTruth"],
          "properties": {
            "mode": { "enum": ["needsRuling", "consumeUserQuota", "declaredOnly"],
              "description": "consumeUserQuota is the ruled treatment (attack.copy-special-rule); sourceOfTruth is this card's own evidence (a card-library record only on a machine definition)." },
            "sourceOfTruth": { "$ref": "urn:pokemon-tcg:card-definition:1.0.0#/$defs/cardEvidenceList" }
          }
        }
      },
      "allOf": [{
        "if": { "required": ["chooser"], "properties": { "chooser": {} } },
        "then": { "properties": { "origins": { "type": "array", "items": { "type": "object", "properties": { "side": { "const": "opponent" } } } } } }
      }, {
        "if": { "properties": { "origins": { "type": "array", "contains": { "type": "object", "properties": { "zone": { "const": "deck" } } } } } },
        "then": { "properties": { "origins": { "type": "array", "maxItems": 1 } }, "not": { "required": ["chooser"], "properties": { "chooser": {} } } },
        "else": { "not": { "required": ["optional"], "properties": { "optional": {} } } }
      }]
    },
    "choice": {
      "type": "object", "additionalProperties": false, "required": ["id", "candidates", "coin"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "candidates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/reference" } },
        "coin": { "enum": [null, "heads", "tails"] },
        "revealed": { "type": "array", "minItems": 1, "maxItems": 60, "uniqueItems": true, "items": { "type": "string", "minLength": 1 },
          "description": "A deck origin: the cards turned face up, the top first; still on top of that deck until the choice is made." }
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false, "required": ["reference", "copyId", "performed", "failureReceipt", "phase", "damageCoins", "effectCards"],
      "properties": {
        "effectCards": {
          "description": "Counted before-damage effect results of this execution, in resolution order; each also has one public damage.effect-count receipt.",
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["effectId", "cards"],
            "properties": {
              "effectId": { "type": "string", "minLength": 1 },
              "cards": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "count": { "type": "integer", "minimum": 0, "maximum": 30, "description": "A counted number that is not cards (damage counters placed); cards is then empty." }
            }
          }
        },
        "damageCoins": { "oneOf": [
          { "type": "null" }, { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/damageCoinPreparation" }
        ] },
        "reference": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/reference" }] },
        "copyId": { "type": ["string", "null"], "minLength": 1 }, "performed": { "type": "boolean" },
        "phase": { "enum": ["failure-check", "body"] },
        "failureReceipt": { "oneOf": [
          { "type": "null" }, { "$ref": "urn:pokemon-tcg:attack-failure:1.0.0#/$defs/receipt" },
          { "$ref": "urn:pokemon-tcg:attack-failure:1.0.0#/$defs/paymentReceipt" },
          { "$ref": "urn:pokemon-tcg:attack-failure:1.0.0#/$defs/predicateReceipt" }
        ] }
      },
      "allOf": [{
        "if": { "properties": { "reference": { "type": "null" } } },
        "then": { "properties": { "copyId": { "type": "null" } } },
        "else": { "properties": { "copyId": { "type": "string" } } }
      }]
    },
    "suspended": {
      "type": "object", "additionalProperties": false, "required": ["execution", "options", "damageModels", "continuation"],
      "properties": {
        "execution": { "$ref": "#/$defs/execution" },
        "options": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/damageOptions" },
        "damageModels": { "oneOf": [
          { "type": "null" }, { "type": "array", "items": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/damageModel" } }
        ] },
        "continuation": { "allOf": [
          { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/resolution" },
          { "type": "object", "required": ["copyChoice"], "properties": { "copyChoice": {},
            "action": { "type": "object", "properties": { "op": { "const": "copyAttack" } } } } }
        ] }
      }
    }
  }
}
