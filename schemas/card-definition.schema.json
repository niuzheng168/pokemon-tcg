{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pokemon-tcg:card-definition:1.0.0",
  "title": "Region-version-bound executable card definition (not Wiki metadata or a printing)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "definitionId", "ruleset", "name", "nameKey", "kind", "sourceOfTruth", "implementation", "deckLimits", "mechanics"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "definitionId": { "$ref": "#/$defs/id" },
    "ruleset": { "$ref": "#/$defs/ruleset" },
    "name": { "$ref": "#/$defs/text" },
    "nameKey": { "$ref": "#/$defs/id" },
    "kind": { "enum": ["pokemon", "trainer", "energy"] },
    "sourceOfTruth": { "$ref": "#/$defs/cardEvidenceList" },
    "prismStar": {
      "$ref": "#/$defs/prismStarRule",
      "description": "Reviewed immutable printed Prism Star rule, not a symbol/name inference or a runtime zone flag."
    },
    "metadataRefs": { "type": "array", "items": { "$ref": "#/$defs/metadataRef" } },
    "implementation": { "$ref": "#/$defs/implementation" },
    "deckLimits": { "$ref": "#/$defs/deckLimits" },
    "mechanics": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "pokemon" } } }, "then": { "properties": { "mechanics": { "$ref": "#/$defs/pokemon" } } } },
    { "if": { "properties": { "kind": { "const": "trainer" } } }, "then": { "properties": { "mechanics": { "$ref": "#/$defs/trainer" } } } },
    { "if": { "properties": { "kind": { "const": "energy" } } }, "then": { "properties": { "mechanics": { "$ref": "#/$defs/energy" } } } },
    {
      "if": { "required": ["prismStar"], "properties": { "prismStar": {} } },
      "then": {
        "properties": { "deckLimits": { "type": "object", "properties": { "sameName": { "const": 1 } } } },
        "allOf": [
          { "if": { "properties": { "kind": { "const": "pokemon" } } },
            "then": { "properties": { "mechanics": { "type": "object",
              "properties": { "stage": { "const": "basic" }, "ruleBox": { "const": true } } } } } },
          { "if": { "properties": { "kind": { "const": "energy" } } },
            "then": { "properties": { "mechanics": { "type": "object", "properties": { "category": { "const": "special" } } } } } }
        ]
      }
    }
  ],
  "$defs": {
    "prismStarRule": {
      "type": "object", "additionalProperties": false, "required": ["sourceOfTruth"],
      "properties": { "sourceOfTruth": { "$ref": "#/$defs/cardEvidenceList" } },
      "$comment": "CN-formats-extra pinned SHA256 97893c30b6cbd694fd699b05f4fb376cd600627d085aaba56901e896824d897a: Prism Star section. Same-name one; attempted discard/KO/use-end disposal is replaced by the original owner's Lost Zone. Particular card identity still needs independent approval."
    },
    "id": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$" },
    "text": { "type": "string", "minLength": 1 },
    "natural": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "damageValue": { "type": "integer", "minimum": 0, "maximum": 9007199254740990, "multipleOf": 10 },
    "energyType": { "enum": ["Grass", "Fire", "Water", "Lightning", "Psychic", "Fighting", "Darkness", "Metal", "Fairy", "Colorless"] },
    "pokemonType": { "enum": ["Grass", "Fire", "Water", "Lightning", "Psychic", "Fighting", "Darkness", "Metal", "Fairy", "Dragon", "Colorless"] },
    "ruleset": {
      "type": "object", "additionalProperties": false, "required": ["region", "version"],
      "properties": {
        "region": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "version": { "type": "string", "pattern": "^V[0-9]{8}$" }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceId", "kind", "url", "locator"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["official-card", "official-erratum", "official-rule"] },
        "url": { "type": "string", "pattern": "^https://(www\\.pokemon\\.cn|image\\.pokemon\\.com\\.cn|special\\.pokemon\\.cn)/" },
        "locator": { "$ref": "#/$defs/text" },
        "textSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "observedOn": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "libraryEvidence": {
      "description": "A machine-implemented card's own record: the card library entry (MIK, else 52Poké) whose text two image readers confirmed. Never official evidence; only a definition of implementation tier 'machine' may rest on it.",
      "type": "object", "additionalProperties": false,
      "required": ["sourceId", "kind", "url", "locator"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/id" },
        "kind": { "const": "card-library" },
        "url": { "type": "string", "pattern": "^https://(tcg\\.mik\\.moe|wiki\\.52poke\\.com)/" },
        "locator": { "$ref": "#/$defs/text" },
        "observedOn": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "evidenceRef": {
      "description": "Release wire format ONLY. Resolve from the shard's source table before card shape, evidence authority or executable checks. Runtime evidence lists intentionally do not accept unresolved references.",
      "type": "object", "additionalProperties": false, "required": ["sourceId", "kind"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["official-card", "official-erratum", "official-rule", "card-library"] }
      }
    },
    "evidenceList": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
    "cardEvidenceList": {
      "description": "Evidence for a particular card: official (card face, erratum) or, for a machine-implemented definition, its card-library record (the kernel checks which may be used).",
      "type": "array", "minItems": 1, "items": { "anyOf": [{ "$ref": "#/$defs/evidence" }, { "$ref": "#/$defs/libraryEvidence" }] }
    },
    "metadataRef": {
      "type": "object", "additionalProperties": false, "required": ["provider", "id"],
      "properties": {
        "provider": { "enum": ["52poke", "academy-legacy", "other"] },
        "id": { "$ref": "#/$defs/text" },
        "revision": { "$ref": "#/$defs/text" },
        "url": { "$ref": "#/$defs/text" }
      }
    },
    "implementation": {
      "type": "object", "additionalProperties": false, "required": ["status", "testIds"],
      "properties": {
        "status": { "enum": ["unimplemented", "partial", "verified"] },
        "tier": {
          "description": "How the definition was made: 'reviewed' (hand-checked against the card face; the default) or 'machine' (card text confirmed by machine image reading, effects machine-translated and checked by the kernel). Shown to players; never mixed up.",
          "enum": ["reviewed", "machine"]
        },
        "testIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "unsupportedEffects": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
      },
      "allOf": [{
        "if": { "properties": { "status": { "const": "verified" } } },
        "then": {
          "properties": {
            "testIds": { "type": "array", "minItems": 1 },
            "unsupportedEffects": { "type": "array", "maxItems": 0 }
          }
        }
      }]
    },
    "deckLimits": {
      "type": "object", "additionalProperties": false, "required": ["sameName", "groups"],
      "properties": {
        "sameName": { "type": ["integer", "null"], "minimum": 1 },
        "groups": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["key", "maximum", "sourceOfTruth"],
            "properties": {
              "key": { "$ref": "#/$defs/id" },
              "maximum": { "type": "integer", "minimum": 1 },
              "sourceOfTruth": { "$ref": "#/$defs/cardEvidenceList" }
            }
          }
        }
      }
    },
    "effect": {
      "type": "object", "additionalProperties": false,
      "required": ["effectId", "handlerId", "parameters", "sourceOfTruth"],
      "properties": {
        "effectId": { "$ref": "#/$defs/id" },
        "handlerId": { "$ref": "#/$defs/id" },
        "parameters": { "type": "object" },
        "activationCosts": { "$ref": "urn:pokemon-tcg:activation-cost:1.0.0" },
        "trigger": { "$ref": "urn:pokemon-tcg:trigger:1.0.0#/$defs/anyDescriptor" },
        "playCount": {
          "description": "Item 「可以使用1张或者同时使用N张，根据使用的张数不同效果也不同」「必须同时使用N张」 (trainer.joint-play): this entry belongs to the effect of N cards of this name played together, which happens once for all N (「这个效果，N张卡牌只发动1次」). The Item's entries without it are its effect when one card is played alone.",
          "type": "integer", "minimum": 2, "maximum": 4
        },
        "sourceOfTruth": { "$ref": "#/$defs/cardEvidenceList" }
      },
      "description": "The referenced reviewed handler owns phase/target/duration semantics and a strict parameter schema. Unknown handler IDs/parameters MUST be rejected at the playability gate, not interpreted as no-ops."
    },
    "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
    "attack": {
      "type": "object", "additionalProperties": false,
      "required": ["attackId", "name", "cost", "printedDamage", "effects", "sourceOfTruth"],
      "properties": {
        "attackId": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "cost": { "type": "array", "items": { "$ref": "#/$defs/energyType" } },
        "printedDamage": {
          "type": ["object", "null"],
          "additionalProperties": false, "required": ["value", "operator"],
          "properties": {
            "value": { "$ref": "#/$defs/damageValue" },
            "operator": { "enum": ["fixed", "plus", "minus", "times"] }
          }
        },
        "effects": { "$ref": "#/$defs/effects" },
        "failureCheck": { "$ref": "urn:pokemon-tcg:attack-failure:1.0.0#/$defs/self" },
        "condition": {
          "description": "「这个招式，只有在……时才可使用」: judged whenever the attack could be declared; when unmet it cannot be declared (I.A-01 step 1-a), unlike a failure check judged after declaring. predicate reads only facts of that moment (self, own and opposing Active; no target, coin, counted-effect or Prizes-taken facts).",
          "type": "object", "additionalProperties": false, "required": ["predicate"],
          "properties": { "predicate": { "$ref": "urn:pokemon-tcg:battle-predicate:1.0.0" } }
        },
        "specialRule": { "enum": ["GX", "VSTAR"] },
        "benchUse": { "const": true, "description": "「这个招式，即使这只宝可梦在备战区也能使用」 (attack.bench): this printed attack may also be declared by the Pokémon on the Bench; every other rule for using attacks still applies to that Pokémon." },
        "sourceOfTruth": { "$ref": "#/$defs/cardEvidenceList" }
      }
    },
    "ability": {
      "type": "object", "additionalProperties": false,
      "required": ["abilityId", "name", "mode", "usage", "effects", "sourceOfTruth"],
      "properties": {
        "abilityId": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "mode": { "enum": ["activated", "triggered", "continuous"] },
        "trigger": { "$ref": "urn:pokemon-tcg:trigger:1.0.0#/$defs/anyDescriptor" },
        "specialRule": { "enum": ["VSTAR"] },
        "costs": { "$ref": "urn:pokemon-tcg:activation-cost:1.0.0" },
        "zone": {
          "description": "「如果这张卡牌在手牌中／弃牌区的话，则…可以使用」 (I.A-02 unless printed otherwise; II.A): an activated Ability used while the card itself is in its owner's hand or discard pile, not in play. Usage scope pokemon counts this card.",
          "enum": ["hand", "discard"]
        },
        "endsTurn": {
          "description": "「如果使用了，则自己的回合结束」 (II.E-20 文例3): after its effects resolve, the player's turn ends. Activated Abilities only.",
          "const": true
        },
        "usage": {
          "type": ["object", "null"], "additionalProperties": false, "required": ["period", "scope", "key", "limit"],
          "properties": {
            "period": { "enum": ["turn", "game", "unlimited"] }, "scope": { "enum": ["pokemon", "player"] },
            "key": { "$ref": "#/$defs/id" }, "limit": { "type": ["integer", "null"], "minimum": 1 }
          }
        },
        "condition": {
          "description": "Printed use conditions of an activated Ability, checked whenever it could be declared; every listed condition must hold. firstOwnTurn: the holder's own first turn (I.A-05). sourceActive: this Pokémon is the Active Pokémon. previousOpponentKnockout: one of the holder's Pokémon was Knocked Out during the opponent's last turn. attachedEnergyType: 「如果这只宝可梦身上附着了【X】能量的话」, any attached Energy currently providing that type (II.D-08 FAQ). predicate: any other printed board, zone or history condition (no target, coin, counted-effect or Prizes-taken facts).",
          "type": "object", "additionalProperties": false, "minProperties": 1,
          "properties": {
            "firstOwnTurn": { "const": true }, "sourceActive": { "const": true }, "previousOpponentKnockout": { "const": true },
            "attachedEnergyType": { "$ref": "#/$defs/energyType" }, "predicate": { "$ref": "urn:pokemon-tcg:battle-predicate:1.0.0" },
            "prizesRemaining": { "const": "moreThanOpponent", "description": "「自己的剩余奖赏卡张数，比对手的剩余奖赏卡张数多的话」." }
          }
        },
        "effects": { "type": "array", "allOf": [{ "$ref": "#/$defs/effects" }], "minItems": 1 },
        "sourceOfTruth": { "$ref": "#/$defs/cardEvidenceList" }
      },
      "allOf": [{
        "if": { "anyOf": [
          { "required": ["condition"], "properties": { "condition": {} } },
          { "required": ["endsTurn"], "properties": { "endsTurn": {} } }
        ] },
        "then": { "properties": { "mode": { "const": "activated" } } }
      }, {
        "if": { "required": ["zone"], "properties": { "zone": {} } },
        "then": {
          "required": ["usage"],
          "properties": { "mode": { "const": "activated" }, "usage": { "type": "object" },
            "condition": { "type": "object", "properties": { "sourceActive": false, "attachedEnergyType": false } } },
          "not": { "anyOf": [{ "required": ["specialRule"], "properties": { "specialRule": {} } }, { "required": ["costs"], "properties": { "costs": {} } }] }
        }
      }]
    },
    "pokemon": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "evolvesFrom", "hp", "types", "weakness", "resistance", "retreatCost", "attacks", "abilities", "ruleBox", "prizeCount", "tags", "effects"],
      "properties": {
        "stage": { "enum": ["basic", "stage1", "stage2", "VSTAR", "VMAX", "V-UNION", "special"] },
        "evolvesFrom": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$" },
        "basicAncestor": {
          "description": "Reviewed Basic name identity for Stage 2 evolution paths, not guessed from which Stage 1 cards happen to be in this deck/catalog.",
          "type": "object", "additionalProperties": false, "required": ["nameKey", "sourceOfTruth"],
          "properties": { "nameKey": { "$ref": "#/$defs/id" },
            "otherNameKeys": { "description": "Further Basic names when the Stage 1 of that name is printed evolving from different Basics (「从古老的贝壳化石进化」 and 「从谜之化石进化」).",
              "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
            "sourceOfTruth": { "$ref": "#/$defs/cardEvidenceList" } }
        },
        "hp": {
          "title": "Printed maximum HP (immutable card definition)",
          "description": "This is the printed/base maximum HP, never remaining battle HP. Runtime counters and effects are stored on the in-play Pokémon; effective maximum and current HP are derived.",
          "type": "integer", "minimum": 10, "multipleOf": 10, "maximum": 9007199254740990
        },
        "types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/pokemonType" } },
        "weakness": {
          "type": ["object", "null"], "additionalProperties": false, "required": ["type", "operation", "value"],
          "properties": {
            "type": { "$ref": "#/$defs/pokemonType" },
            "operation": { "enum": ["multiply", "add"] },
            "value": { "type": "integer", "minimum": 1 }
          }
        },
        "resistance": {
          "type": ["object", "null"], "additionalProperties": false, "required": ["type", "value"],
          "properties": { "type": { "$ref": "#/$defs/pokemonType" }, "value": { "$ref": "#/$defs/damageValue" } }
        },
        "retreatCost": { "$ref": "#/$defs/natural" },
        "attacks": { "type": "array", "items": { "$ref": "#/$defs/attack" } },
        "abilities": {
          "description": "All printed Abilities, including continuous ones. Removal/counting applies to these identities, not intrinsic rules or display-text guesses.",
          "type": "array", "items": { "$ref": "#/$defs/ability" }
        },
        "ruleBox": { "type": "boolean" },
        "prizeCount": { "type": "integer", "minimum": 0 },
        "tags": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "effects": {
          "description": "Intrinsic non-Ability card-rule bindings. Never place an Ability here to bypass Ability removal or counting.",
          "$ref": "#/$defs/effects"
        },
        "vUnion": {
          "description": "「宝可梦 V-UNION 的放置方法：对战中有1次机会，在自己的回合，可将自己弃牌区中的4种X V-UNION 组合起来，放于备战区。」 (pokemon.v-union): this card is piece N (printed number order) of a Pokémon V-UNION; every piece carries the whole combined Pokémon. Its owner may, once per game per name, put one of each of the 4 pieces from the discard pile onto the Bench as ONE Pokémon; no other way puts it into play.",
          "type": "object", "additionalProperties": false, "required": ["piece", "sourceOfTruth"],
          "properties": { "piece": { "enum": [1, 2, 3, 4] }, "sourceOfTruth": { "$ref": "#/$defs/cardEvidenceList" } }
        },
        "itemCard": {
          "description": "「这张卡牌，可以作为HP为60的【无】属性的【基础】宝可梦，放于场上」 (pokemon.item-card): a card printed as an Item. Outside play (hand, deck, discard pile, Prize cards) it is that Item for card selectors, deck building and setup; it is played from the hand onto the Bench as an Item, and in play it is this Basic Pokémon. leave: 「如果在自己的回合的话，则可将处于场上的这张卡牌放于弃牌区」 (field → discard) or 「可将处于战斗场上的这张卡牌放回牌库下方。（将放于其身上的卡牌，全部放于弃牌区。）」 (active → deckBottom), while it is not evolved.",
          "type": "object", "additionalProperties": false, "required": ["leave", "sourceOfTruth"],
          "properties": {
            "leave": { "type": "object", "additionalProperties": false, "required": ["from", "to"],
              "properties": { "from": { "enum": ["field", "active"] }, "to": { "enum": ["discard", "deckBottom"] } } },
            "sourceOfTruth": { "$ref": "#/$defs/cardEvidenceList" }
          }
        }
      },
      "allOf": [{
        "if": { "properties": { "stage": { "const": "stage2" } } },
        "then": { "required": ["basicAncestor"], "properties": { "basicAncestor": {} } },
        "else": { "not": { "required": ["basicAncestor"], "properties": { "basicAncestor": {} } } }
      }, {
        "if": { "properties": { "stage": { "const": "V-UNION" } } },
        "then": { "required": ["vUnion"], "properties": { "vUnion": {} } },
        "else": { "not": { "required": ["vUnion"], "properties": { "vUnion": {} } } }
      }, {
        "if": { "required": ["itemCard"], "properties": { "itemCard": {} } },
        "then": { "properties": { "stage": { "const": "basic" }, "ruleBox": { "const": false }, "attacks": { "type": "array", "maxItems": 0 } } }
      }]
    },
    "trainer": {
      "type": "object", "additionalProperties": false, "required": ["category", "effects"],
      "properties": {
        "category": { "enum": ["item", "supporter", "stadium", "tool"] },
        "tags": {
          "description": "Printed card tags such as 古代/未来/TAG TEAM on a Trainer. Recorded identity, read only by a Trainer CardSelector tagsAll.",
          "type": "array", "uniqueItems": true, "minItems": 1, "items": { "$ref": "#/$defs/text" }
        },
        "playCosts": { "$ref": "urn:pokemon-tcg:activation-cost:1.0.0" },
        "optionalPlayCosts": {
          "description": "Item/Supporter 「另外，当使用这张卡牌时，可将N张自己的手牌放于弃牌区。在这种情况下，…」 (effects.optional-cost): the player chooses when playing the card, before its effects, whether to pay; only the cn.ifPaid@1 parts need it, and it may be paid only when one of them could change something.",
          "$ref": "urn:pokemon-tcg:activation-cost:1.0.0"
        },
        "condition": {
          "description": "Printed play condition 「只有在…时才可使用」, checked whenever the card could be played (the card is still in hand); every listed condition must hold. prizesRemaining moreThanOpponent: the player has more Prize cards remaining than the opponent. firstOwnTurn: 「只能在自己最初的回合使用」. secondPlayerFirstTurn: 「只有在后攻玩家的最初回合才可使用」 (the player went second and this is that player's first turn). predicate: any other printed board, zone or history condition about the player's side (no this-Pokémon, target, coin, counted-effect or Prizes-taken facts).",
          "type": "object", "additionalProperties": false, "minProperties": 1,
          "properties": {
            "prizesRemaining": { "const": "moreThanOpponent" }, "firstOwnTurn": { "const": true }, "secondPlayerFirstTurn": { "const": true },
            "predicate": { "$ref": "urn:pokemon-tcg:battle-predicate:1.0.0" }
          }
        },
        "endsTurn": {
          "description": "Item/Supporter text 「如果使用了这张卡牌的话，则自己的回合结束」 (II.E-20): after the card resolves and is discarded, the turn ends.",
          "const": true
        },
        "firstTurnUse": {
          "description": "Supporter text 「这张卡牌，即使是先攻玩家的最初回合也可以使用」: the I.B-03 first-turn restriction does not apply (II.E-27 principle).",
          "const": true
        },
        "effects": { "$ref": "#/$defs/effects" },
        "grantedAttacks": { "type": "array", "items": { "$ref": "#/$defs/attack" } },
        "grantedAttackHolder": {
          "description": "「身上放有这张卡牌的「一击」宝可梦／拥有招式「X」的宝可梦，可以使用这张卡牌上的招式」: only a holder matching this may use grantedAttacks (tools.granted-attack).",
          "$ref": "urn:pokemon-tcg:energy-mechanics:1.0.0#/$defs/pokemonSelector"
        },
        "turnEndDiscard": {
          "description": "「放于宝可梦身上的这张卡牌，将在自己的回合结束时被放于弃牌区」: this Tool is put into its owner's discard pile at the end of its owner's turn, unless its effects are removed (tools.granted-attack).",
          "const": true
        },
        "grantedAbilities": {
          "description": "「身上放有这张卡牌的「宝可梦V」，可以使用这个【VSTAR】力量」 and the Ability printed on the Tool (tools.granted-ability): the holder may use it like an activated Ability while this Tool's effects apply; it is not the holder's own Ability.",
          "type": "array", "minItems": 1,
          "items": { "allOf": [{ "$ref": "#/$defs/ability" }, {
            "type": "object", "required": ["usage"], "properties": { "mode": { "const": "activated" }, "usage": { "type": "object" } },
            "not": { "anyOf": [{ "required": ["zone"], "properties": { "zone": {} } }, { "required": ["costs"], "properties": { "costs": {} } }] }
          }] }
        },
        "grantedAbilityHolder": {
          "description": "「身上放有这张卡牌的「宝可梦V」」: only a holder matching this may use grantedAbilities (tools.granted-ability).",
          "$ref": "urn:pokemon-tcg:energy-mechanics:1.0.0#/$defs/pokemonSelector"
        },
        "discardRecall": {
          "description": "「在自己的回合，如果将2张自己的手牌（除「查克洛」外）放于弃牌区的话，则将这张「查克洛」从弃牌区，在给对手看过之后，加入手牌。（这个效果，不包含在自己的回合可以使用的支援者的张数内。）」 (trainer.discard-recall): during its owner's turn, while this card is in its owner's discard pile, the owner may pay these costs to put it into the hand, shown to the opponent. This is not playing the card.",
          "type": "object", "additionalProperties": false, "required": ["costs"],
          "properties": { "costs": { "$ref": "urn:pokemon-tcg:activation-cost:1.0.0" } }
        },
        "opponentTurnEndDiscard": {
          "description": "「放于宝可梦身上的这张卡牌，将在对手的回合结束时被放于弃牌区」: this attached Tool is put into its owner's discard pile at the end of the opponent's turn, unless its effects are removed (tools.turn-end-discard).",
          "const": true
        },
        "handAttachExcept": {
          "description": "Tool 「（当将这张卡牌从手牌使出放于宝可梦身上时，如果会导致该宝可梦【昏厥】的话，则无法放于该宝可梦身上。）」 beside its own printed maximum-HP decrease −N on X (tools.hand-attach-except): played from the hand, this Tool cannot be put on a Pokémon that matches selector X and state {remainingHpAtMost: N} now (that decrease would Knock it Out). Judged as printed even while Tool effects are removed; effects that attach it otherwise are not restricted.",
          "type": "object", "additionalProperties": false, "minProperties": 1,
          "properties": {
            "selector": { "$ref": "urn:pokemon-tcg:energy-mechanics:1.0.0#/$defs/pokemonSelector" },
            "state": { "$ref": "urn:pokemon-tcg:battle-value:1.0.0#/$defs/targetState" }
          }
        }
      },
      "allOf": [{
        "if": { "anyOf": [{ "required": ["grantedAttackHolder"], "properties": { "grantedAttackHolder": {} } }, { "required": ["turnEndDiscard"], "properties": { "turnEndDiscard": {} } }] },
        "then": { "required": ["grantedAttacks"], "properties": { "grantedAttacks": { "type": "array", "minItems": 1 } } }
      }, {
        "if": { "required": ["grantedAttacks"], "properties": { "grantedAttacks": { "type": "array", "minItems": 1 } } },
        "then": { "properties": { "category": { "const": "tool" } } }
      }, {
        "if": { "required": ["opponentTurnEndDiscard"], "properties": { "opponentTurnEndDiscard": {} } },
        "then": { "properties": { "category": { "const": "tool" } } }
      }, {
        "if": { "required": ["handAttachExcept"], "properties": { "handAttachExcept": {} } },
        "then": { "properties": { "category": { "const": "tool" } } }
      }, {
        "if": { "required": ["grantedAbilityHolder"], "properties": { "grantedAbilityHolder": {} } },
        "then": { "required": ["grantedAbilities"], "properties": { "grantedAbilities": {} } }
      }, {
        "if": { "required": ["grantedAbilities"], "properties": { "grantedAbilities": {} } },
        "then": { "properties": { "category": { "const": "tool" } } }
      }, {
        "if": { "required": ["firstTurnUse"], "properties": { "firstTurnUse": {} } },
        "then": { "properties": { "category": { "const": "supporter" } } }
      }, {
        "if": { "required": ["endsTurn"], "properties": { "endsTurn": {} } },
        "then": { "properties": { "category": { "enum": ["item", "supporter"] } } }
      }]
    },
    "energy": {
      "type": "object", "additionalProperties": false, "required": ["category", "baseUnits", "effects"],
      "properties": {
        "category": { "enum": ["basic", "special"] },
        "tags": {
          "description": "Printed card tags on a Special Energy (「连击能量」 is a 「连击」 card). Recorded identity, read only by an Energy CardSelector tagsAll.",
          "type": "array", "uniqueItems": true, "minItems": 1, "items": { "$ref": "#/$defs/text" }
        },
        "attachCosts": {
          "description": "Costs of attaching this card FROM HAND; never charged again for Prize/discard attachment.",
          "$ref": "urn:pokemon-tcg:activation-cost:1.0.0"
        },
        "handAttachTo": { "$ref": "urn:pokemon-tcg:energy-mechanics:1.0.0#/$defs/pokemonSelector" },
        "remainOn": { "$ref": "urn:pokemon-tcg:energy-mechanics:1.0.0#/$defs/pokemonSelector" },
        "baseUnits": {
          "type": "array",
          "items": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/energyType" } }
        },
        "effects": { "$ref": "#/$defs/effects" }
      },
      "allOf": [{
        "if": { "properties": { "category": { "const": "basic" } } },
        "then": {
          "properties": {
            "baseUnits": {
              "type": "array",
              "minItems": 1, "maxItems": 1,
              "items": {
                "type": "array", "minItems": 1, "maxItems": 1,
                "items": { "enum": ["Grass", "Fire", "Water", "Lightning", "Psychic", "Fighting", "Darkness", "Metal", "Fairy"] }
              }
            },
            "effects": { "type": "array", "maxItems": 0 }
          },
          "not": { "anyOf": [
            { "required": ["attachCosts"], "properties": { "attachCosts": {} } },
            { "required": ["handAttachTo"], "properties": { "handAttachTo": {} } },
            { "required": ["remainOn"], "properties": { "remainOn": {} } }
          ] }
        }
      }]
    }
  }
}
