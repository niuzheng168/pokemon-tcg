{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pokemon-tcg:game-command:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["player", "expectedRevision", "action"],
  "properties": {
    "player": { "enum": [0, 1] },
    "expectedRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "action": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "requestId", "allocations"],
          "properties": {
            "type": { "const": "allocateCounters" },
            "requestId": { "type": "string", "minLength": 1 },
            "allocations": { "$ref": "urn:pokemon-tcg:counter-distribution:1.0.0#/$defs/allocations" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "requestId", "selected"],
          "properties": {
            "type": { "const": "answer" }, "requestId": { "type": "string", "minLength": 1 },
            "selected": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "cardId"],
          "properties": { "type": { "enum": ["bench", "playTrainer", "recallCard"], "description": "recallCard: a Trainer's own discardRecall from the discard pile (trainer.discard-recall)." }, "cardId": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "cardId", "jointCardIds"],
          "properties": { "type": { "const": "playTrainer", "description": "trainer.joint-play: cardId and these other cards of its name, from the hand, played together as one use." },
            "cardId": { "type": "string", "minLength": 1 },
            "jointCardIds": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "cardId", "pokemonId"],
          "properties": {
            "type": { "enum": ["evolve", "attachEnergy"] }, "cardId": { "type": "string", "minLength": 1 },
            "pokemonId": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "cardId", "pokemonId", "jointCardIds"],
          "properties": { "type": { "const": "attachEnergy", "description": "turn.energy-together: cardId and this other Energy card from the hand attached to pokemonId at once, as the turn's one attachment." },
            "cardId": { "type": "string", "minLength": 1 }, "pokemonId": { "type": "string", "minLength": 1 },
            "jointCardIds": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "cardIds"],
          "properties": { "type": { "const": "vUnion", "description": "pokemon.v-union: pieces 1–4 of one Pokémon V-UNION from the discard pile onto the Bench as one Pokémon." },
            "cardIds": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "pokemonId"],
          "properties": { "type": { "const": "leavePlay", "description": "A pokemon.item-card card's own 「…可将处于场上的这张卡牌放于弃牌区」 / 「…放回牌库下方」." },
            "pokemonId": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "attackId"],
          "properties": { "type": { "const": "attack" }, "attackId": { "type": "string", "minLength": 1 },
            "referenceId": { "type": "string", "minLength": 1 },
            "pokemonId": { "type": "string", "minLength": 1, "description": "A Benched Pokémon using its own benchUse attack (attack.bench)." } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "abilityId"],
          "properties": {
            "type": { "const": "useAbility" }, "pokemonId": { "type": "string", "minLength": 1 },
            "cardId": { "type": "string", "minLength": 1, "description": "An Ability used while this card is in its owner's hand or discard pile." },
            "toolId": { "type": "string", "minLength": 1, "description": "The Ability printed on this Tool attached to pokemonId (tools.granted-ability)." },
            "abilityId": { "type": "string", "minLength": 1 }
          },
          "oneOf": [{ "required": ["pokemonId"] }, { "required": ["cardId"] }]
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type"],
          "properties": { "type": { "enum": ["endTurn", "retreat", "concede", "useStadium"] } }
        }
      ]
    }
  }
}
