{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pokemon-tcg:activation-cost:1.0.0",
  "title": "Mandatory activation conditions, not optional effect discards or attack Energy requirements",
  "type": "array", "minItems": 1,
  "items": {
    "type": "object", "additionalProperties": false,
    "required": ["costId", "kind", "count", "selector", "sourceOfTruth"],
    "properties": {
      "costId": { "$ref": "urn:pokemon-tcg:card-definition:1.0.0#/$defs/id" },
      "kind": { "enum": ["discardHand", "lostHand", "bottomHand", "discardAttached"], "description": "discardHand: 「只有将自己的N张手牌放于弃牌区后才可使用」; lostHand: 「…放于放逐区后才可使用」; bottomHand: 「如果将自己的N张手牌放回牌库下方的话，则可使用」 (the paid cards go to the deck bottom in the order chosen, the last chosen lowest); discardAttached: 「如果将这只宝可梦身上附着的N个X放于弃牌区的话，则可使用」 (an in-play Pokémon's own Ability only: cards attached to that Pokémon, never mixed with hand costs)." },
      "count": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
      "selector": { "$ref": "urn:pokemon-tcg:card-selector:1.0.0" },
      "sourceOfTruth": { "$ref": "urn:pokemon-tcg:card-definition:1.0.0#/$defs/cardEvidenceList" }
    }
  },
  "$defs": {
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "player", "sourceId", "kind", "groups"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "player": { "enum": [0, 1] },
        "sourceId": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["trainer", "ability", "stadium", "energy", "trigger", "entry", "recall", "copy"],
          "description": "copy: the copied Supporter's own play cost (effects.copy-supporter); sourceId is that Supporter card." },
        "groups": {
          "type": "array", "minItems": 1, "items": {
            "type": "object", "additionalProperties": false, "required": ["costId", "cardIds"],
            "properties": {
              "costId": { "type": "string", "minLength": 1 },
              "cardIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    }
  }
}
