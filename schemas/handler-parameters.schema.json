{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pokemon-tcg:core-handler-parameters:1.0.0",
  "$defs": {
    "ownedAttackLock": { "$ref": "urn:pokemon-tcg:owned-attack-lock:1.0.0" },
    "discardStadium": { "$ref": "urn:pokemon-tcg:field-cards:1.0.0" },
    "stadiumProtection": {
      "type": "object", "additionalProperties": false, "required": ["effect"],
      "properties": { "effect": { "$ref": "urn:pokemon-tcg:field-cards:1.0.0#/$defs/protection" } }
    },
    "counterDistribution": { "$ref": "urn:pokemon-tcg:counter-distribution:1.0.0" },
    "pokemonHealing": { "$ref": "urn:pokemon-tcg:healing:1.0.0" },
    "prizeExchange": { "$ref": "urn:pokemon-tcg:prize-exchange:1.0.0" },
    "shuffleHandToBottom": {
      "type": "object", "additionalProperties": false, "required": ["side"],
      "properties": { "side": { "enum": ["own", "opponent", "both"] } }
    },
    "drawCount": {
      "description": "A fixed count, or the drawing player's own remaining Prize cards at resolution (「与自己剩余奖赏卡张数相同数量」); ifRemainingPrizes draws `then` instead of `otherwise` while exactly `equals` Prize cards remain (「如果自己的剩余奖赏卡张数为6张的话，则抽取的张数变为8张」).",
      "oneOf": [
        { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/count" },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "remainingPrizes" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "equals", "then", "otherwise"], "properties": {
          "kind": { "const": "ifRemainingPrizes" }, "equals": { "type": "integer", "minimum": 0, "maximum": 6 },
          "then": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/count" },
          "otherwise": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/count" }
        } }
      ]
    },
    "handBottomDraw": {
      "type": "object", "additionalProperties": false, "required": ["side", "ownDraw", "opponentDraw"],
      "properties": {
        "side": { "enum": ["own", "opponent", "both"] },
        "ownDraw": { "$ref": "#/$defs/drawCount" },
        "opponentDraw": { "$ref": "#/$defs/drawCount" }
      }
    },
    "handDeckDraw": {
      "description": "CN II.E-36 p74 then II.E-19 p62–63: whole hands into their own decks with a full-deck shuffle, then draws only if that actually happened.",
      "type": "object", "additionalProperties": false, "required": ["side", "ownDraw", "opponentDraw"],
      "properties": {
        "side": { "enum": ["own", "opponent", "both"] },
        "ownDraw": { "$ref": "#/$defs/drawCount" },
        "opponentDraw": { "$ref": "#/$defs/drawCount" }
      }
    },
    "drawPokemonCount": {
      "description": "Draw as many cards as the named side's in-play Pokémon at resolution (Active plus Bench).",
      "type": "object", "additionalProperties": false, "required": ["side"],
      "properties": { "side": { "enum": ["own", "opponent"] } }
    },
    "drawValue": {
      "description": "Draw a count the printed text computes from board, zone or history facts at resolution (「抽取与…数量相同数量的卡牌」, 「抽取2张。如果…的话，则额外抽取2张」); a negative result draws nothing.",
      "type": "object", "additionalProperties": false, "required": ["count"],
      "properties": { "count": { "$ref": "urn:pokemon-tcg:battle-value:1.0.0" } }
    },
    "cardsThenDraw": {
      "description": "One printed card movement, then (II.E-19) a dependent draw for the effect user.",
      "type": "object", "additionalProperties": false, "required": ["cards", "draw"],
      "properties": {
        "cards": { "$ref": "#/$defs/cards" },
        "draw": { "type": "integer", "minimum": 1, "maximum": 900719925474099 }
      }
    },
    "nestedEffect": {
      "description": "A reviewed static core leaf composed by a control handler. Its own parameter validator still applies.",
      "type": "object", "additionalProperties": false, "required": ["handlerId", "parameters"],
      "properties": {
        "handlerId": { "enum": ["cn.switch@1", "cn.condition@1", "cn.attachedEnergy@1", "cn.cards@1", "cn.cardsThenDraw@1",
          "cn.lasting@1", "cn.lastingPlayer@1", "cn.heal@1", "cn.healPokemon@1", "cn.counters@1", "cn.draw@1", "cn.discardStadium@1",
          "cn.fieldReturn@1", "cn.attachDeckEnergy@1", "cn.attachHand@1", "cn.attachDiscard@1", "cn.discardDeckTop@1", "cn.pokemonTransition@1",
          "cn.discardTools@1", "cn.opponentHand@1"] },
        "parameters": { "type": "object" }
      }
    },
    "discardTools": {
      "description": "Put Pokémon Tools attached to that side's Pokémon into their owner's discard pile (I.B-02; II.D-03 文例1 「将放于对手场上宝可梦身上的所有「宝可梦道具」，放于弃牌区」). target: whose Tools; selector: which Tools by printed identity; the effect user chooses; Pokémon protected from this effect offer none.",
      "type": "object", "additionalProperties": false, "required": ["side", "target", "quantity"],
      "properties": {
        "side": { "enum": ["own", "opponent"] }, "target": { "enum": ["any", "active", "bench", "self"] },
        "selector": { "allOf": [{ "$ref": "urn:pokemon-tcg:card-selector:1.0.0" }, { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "trainer" } } }] },
        "quantity": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/cardQuantity" }
      }
    },
    "opponentHand": {
      "allOf": [
        { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/opponentHand" },
        { "type": "object", "not": { "required": ["op"], "properties": { "op": {} } } }
      ]
    },
    "opponentHandLook": {
      "description": "Before damage, look at the opponent's whole hand; the looked-at cards feed this attack's damage (「查看对手的手牌，造成其中训练家张数×N伤害」「如果其中有能量的话，则追加造成N伤害」; II.B-02, II.C-20).",
      "type": "object", "additionalProperties": false, "required": ["mode"],
      "properties": { "mode": { "const": "look" } }
    },
    "countedCards": {
      "description": "Before-damage discard of cards from the user's hand or deck whose actual cards feed this attack's damage (「将自己手牌中任意数量的X放于弃牌区，造成其张数×N」「将自己牌库上方5张卡牌放于弃牌区，造成其中能量的张数×N」; II.B-02).",
      "allOf": [
        { "$ref": "#/$defs/cards" },
        { "type": "object", "properties": { "from": { "enum": ["hand", "deck"] }, "to": { "const": "discard" } } }
      ]
    },
    "optionalCounted": {
      "description": "「若希望，可将…放于弃牌区（／放回手牌／放回牌库）。在这种情况下，追加造成N伤害」「…追加造成其张数×N」 (II.E-10, II.B-02): before damage the user may decline; the cards actually moved (none when declined) feed this attack's damage. effect: the user's own attached Energy discarded or returned, Tools discarded, the user's hand/deck cards discarded, or the Stadium in play discarded.",
      "type": "object", "additionalProperties": false, "required": ["effect"],
      "properties": { "effect": { "$ref": "#/$defs/nestedEffect" } }
    },
    "countedEnergyDiscard": {
      "description": "Before-damage discard of attached Energy whose actual card count feeds this attack's damage (II.B-02, II.D-02 文例1).",
      "allOf": [
        { "$ref": "urn:pokemon-tcg:energy-mechanics:1.0.0#/$defs/attachedAction" },
        { "type": "object", "properties": { "op": { "const": "discardEnergy" }, "side": { "const": "own" }, "measure": { "const": "cards" } } }
      ]
    },
    "coin": {
      "description": "II.C-05: flip once; only the printed result runs the effect, or several printed effects in order (「则A，并B」).",
      "type": "object", "additionalProperties": false, "required": ["outcome"],
      "properties": {
        "outcome": { "enum": ["heads", "tails"] }, "effect": { "$ref": "#/$defs/nestedEffect" },
        "effects": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/nestedEffect" } },
        "otherwise": { "$ref": "#/$defs/nestedEffect", "description": "「如果为正面则A，如果为反面则B」: what the other face does." }
      },
      "oneOf": [{ "required": ["effect"], "properties": { "effect": {} } }, { "required": ["effects"], "properties": { "effects": {} } }]
    },
    "coins": {
      "description": "Several flips, or flips until tails, then by how many show `face`: scale = the nested leaf is written for ONE such flip (「与出现正面次数相同数量」, 「出现正面次数×3张」) and the host multiplies its count; all = 「如果全部都是正面」; atLeast = 「如果出现2次以上正面」.",
      "type": "object", "additionalProperties": false, "required": ["flips", "face", "apply", "effect"],
      "properties": {
        "flips": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/coinFlips" }, "face": { "enum": ["heads", "tails"] },
        "apply": { "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "enum": ["scale", "all"] } } },
          { "type": "object", "additionalProperties": false, "required": ["kind", "count"],
            "properties": { "kind": { "const": "atLeast" }, "count": { "type": "integer", "minimum": 1, "maximum": 60 } } }
        ] },
        "effect": { "$ref": "#/$defs/nestedEffect" }
      }
    },
    "coinResult": {
      "description": "An attack's later effect decided by the coins its own damage already flipped (II.E-38 文例3: 「抛掷3次硬币，造成正面次数×100点伤害。如果全部为反面，则…」). condition reads only coin facts of rolls this attack declares.",
      "type": "object", "additionalProperties": false, "required": ["condition"],
      "properties": {
        "condition": { "$ref": "urn:pokemon-tcg:battle-predicate:1.0.0" },
        "effect": { "$ref": "#/$defs/nestedEffect" },
        "effects": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/nestedEffect" } },
        "otherwise": { "$ref": "#/$defs/nestedEffect" }
      },
      "oneOf": [{ "required": ["effect"], "properties": { "effect": {} } }, { "required": ["effects"], "properties": { "effects": {} } }]
    },
    "optional": {
      "description": "II.E-10: 「若希望，可……」 the user may decline the whole following effect (never a smaller printed quantity).",
      "type": "object", "additionalProperties": false, "required": ["effect"],
      "properties": { "effect": { "$ref": "#/$defs/nestedEffect" } }
    },
    "orElse": {
      "type": "object", "additionalProperties": false, "required": ["first", "otherwise"],
      "properties": { "first": { "$ref": "#/$defs/nestedEffect" }, "otherwise": { "$ref": "#/$defs/nestedEffect" } }
    },
    "then": {
      "description": "CN II.E-19 p62–63: 「A。然后，B」 or 「如果成功执行A了的话，则B」: B runs only if A was at least partly performed.",
      "type": "object", "additionalProperties": false, "required": ["first", "next"],
      "properties": { "first": { "$ref": "#/$defs/nestedEffect" }, "next": { "$ref": "#/$defs/nestedEffect" } }
    },
    "discardDeckTop": {
      "description": "Put the top cards of the named side's deck into its owner's discard pile (II.C-01; II.A: as many as the deck holds).",
      "type": "object", "additionalProperties": false, "required": ["side", "count"],
      "properties": { "side": { "enum": ["own", "opponent"] }, "count": { "type": "integer", "minimum": 1, "maximum": 900719925474099 } }
    },
    "attachThenDraw": {
      "description": "One effect attachment from hand or discard, then (II.E-19) a dependent draw for the effect user.",
      "type": "object", "additionalProperties": false, "required": ["from", "attach", "draw"],
      "properties": {
        "from": { "enum": ["hand", "discard"] },
        "attach": { "$ref": "#/$defs/attachDiscard" },
        "draw": { "type": "integer", "minimum": 1, "maximum": 900719925474099 }
      }
    },
    "replacePokemon": { "$ref": "urn:pokemon-tcg:evolution:1.0.0#/$defs/replace" },
    "benchLimit": {
      "type": "object", "additionalProperties": false, "required": ["effect"],
      "properties": { "effect": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/benchLimit" } }
    },
    "damageValue": {
      "type": "object", "additionalProperties": false, "required": ["expression"],
      "properties": {
        "expression": { "$ref": "urn:pokemon-tcg:battle-value:1.0.0" },
        "rolls": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/damageRollPlans" }
      }
    },
    "prizeDamage": {
      "type": "object", "additionalProperties": false, "required": ["side", "perPrize", "base"],
      "properties": {
        "side": { "enum": ["own", "opponent"] },
        "perPrize": { "type": "integer", "minimum": 10, "maximum": 9007199254740990, "multipleOf": 10 },
        "base": { "type": "integer", "minimum": 0, "maximum": 9007199254740990, "multipleOf": 10 }
      }
    },
    "pokemonTypes": {
      "type": "object", "additionalProperties": false, "required": ["effect"],
      "properties": { "effect": { "$ref": "urn:pokemon-tcg:pokemon-types:1.0.0" } }
    },
    "inspectDeck": { "$ref": "urn:pokemon-tcg:deck-window:1.0.0" },
    "attachDeckEnergy": { "$ref": "urn:pokemon-tcg:deck-energy:1.0.0" },
    "burnCounters": {
      "type": "object", "additionalProperties": false, "required": ["effect"],
      "properties": { "effect": { "$ref": "urn:pokemon-tcg:checkup-effects:1.0.0#/$defs/burnCounters" } }
    },
    "attackGrant": { "$ref": "urn:pokemon-tcg:attack-grant:1.0.0" },
    "copyAttack": { "$ref": "urn:pokemon-tcg:attack-copy:1.0.0#/$defs/action" },
    "fieldReturn": { "$ref": "urn:pokemon-tcg:field-return:1.0.0" },
    "pokemonTransition": {
      "oneOf": [
        { "$ref": "urn:pokemon-tcg:evolution:1.0.0#/$defs/evolve" },
        { "$ref": "urn:pokemon-tcg:evolution:1.0.0#/$defs/devolve" },
        { "$ref": "urn:pokemon-tcg:evolution:1.0.0#/$defs/inherit" }
      ]
    },
    "energyRequirement": {
      "type": "object", "additionalProperties": false, "required": ["effect"],
      "properties": { "effect": { "$ref": "urn:pokemon-tcg:energy-mechanics:1.0.0#/$defs/requirement" } }
    },
    "energyProvision": {
      "type": "object", "additionalProperties": false, "required": ["effect"],
      "properties": { "effect": { "$ref": "urn:pokemon-tcg:energy-mechanics:1.0.0#/$defs/provision" } }
    },
    "energyOptions": { "$ref": "urn:pokemon-tcg:energy-mechanics:1.0.0#/$defs/option" },
    "attachedEnergy": {
      "allOf": [
        { "$ref": "urn:pokemon-tcg:energy-mechanics:1.0.0#/$defs/attachedAction" }
      ]
    },
    "attachIncoming": {
      "type": "object", "additionalProperties": false, "required": ["target"],
      "properties": { "target": { "enum": ["any", "active", "bench"] } }
    },
    "cards": {
      "allOf": [
        { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/cardSelection" },
        { "type": "object", "not": { "required": ["op"], "properties": { "op": {} } } }
      ]
    },
    "shuffle": {
      "type": "object", "additionalProperties": false, "required": ["side", "zone"],
      "properties": { "side": { "enum": ["own", "opponent"] }, "zone": { "enum": ["deck", "hand", "prizes"] } }
    },
    "switch": {
      "description": "CN C-03—05: explicitly identify the switched side, choosing player relative to the source, and affected Active or selected Bench Pokémon.",
      "type": "object", "additionalProperties": false, "required": ["side", "chooser", "affected"],
      "properties": {
        "side": { "enum": ["own", "opponent"] },
        "chooser": { "enum": ["self", "opponent"] },
        "affected": { "enum": ["active", "selected", "source"],
          "description": "source: this effect's own Benched Pokémon becomes the Active Pokémon (「将这只宝可梦与战斗宝可梦互换」)." },
        "selector": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/affectedSelector",
          "description": "Only Benched Pokémon matching this may come in (「与备战区中的【雷】宝可梦互换」「选择对手备战区中的1只【基础】宝可梦」)." },
        "state": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/affectedState" }
      },
      "allOf": [{
        "if": { "properties": { "affected": { "const": "source" } } },
        "then": {
          "properties": { "side": { "const": "own" }, "chooser": { "const": "self" } },
          "not": { "anyOf": [{ "required": ["selector"], "properties": { "selector": {} } }, { "required": ["state"], "properties": { "state": {} } }] }
        }
      }]
    },
    "draw": {
      "type": "object", "additionalProperties": false, "required": ["count"],
      "properties": { "count": { "type": "integer", "minimum": 1, "maximum": 900719925474099 } }
    },
    "empty": { "type": "object", "additionalProperties": false, "maxProperties": 0 },
    "counters": {
      "type": "object", "additionalProperties": false, "required": ["side", "target", "count"],
      "properties": {
        "side": { "enum": ["own", "opponent"] }, "target": { "enum": ["any", "active", "bench", "self", "event", "attacker"] },
        "count": { "type": "integer", "minimum": 1, "maximum": 900719925474099 },
        "targets": { "type": "integer", "minimum": 2, "maximum": 8,
          "description": "「给对手的2只备战宝可梦身上，各放置1个伤害指示物」: distinct Pokémon, each receiving count." }
      },
      "allOf": [{ "if": { "required": ["targets"], "properties": { "targets": {} } },
        "then": { "properties": { "target": { "enum": ["any", "active", "bench"] } } } }]
    },
    "stadiumUse": {
      "description": "A Stadium effect a player may declare 「每次在自己的回合有1次机会」 (I.B-04): once per player per turn under this card's own key; the effect is a reviewed static leaf.",
      "type": "object", "additionalProperties": false, "required": ["key", "effect"],
      "properties": {
        "key": { "$ref": "urn:pokemon-tcg:card-definition:1.0.0#/$defs/id" },
        "effect": { "$ref": "#/$defs/nestedEffect" }
      }
    },
    "knockOut": {
      "description": "「令这只宝可梦昏厥」 (I.D): this Pokémon is Knocked Out at the end of the effect, regardless of HP.",
      "type": "object", "additionalProperties": false, "required": ["target"],
      "properties": { "target": { "const": "self" } }
    },
    "heal": {
      "type": "object", "additionalProperties": false, "required": ["target", "amount"],
      "properties": {
        "target": { "enum": ["any", "active", "bench", "self", "event", "attacker"] },
        "side": { "enum": ["own", "opponent"] },
        "amount": { "type": "integer", "minimum": 10, "multipleOf": 10, "maximum": 9007199254740990 }
      }
    },
    "condition": {
      "type": "object", "additionalProperties": false, "required": ["side", "condition"],
      "properties": {
        "side": { "enum": ["own", "opponent"] }, "condition": { "enum": ["asleep", "paralyzed", "confused", "poisoned", "burned"] },
        "target": { "enum": ["active", "self", "event", "attacker"] },
        "poisonCounters": { "type": "integer", "minimum": 1, "maximum": 900719925474099 }
      }
    },
    "modifier": {
      "type": "object", "additionalProperties": false, "required": ["field", "amount", "scope"],
      "properties": {
        "field": { "enum": ["hp", "retreat", "attackDamage", "defenseDamage"] },
        "amount": { "type": "integer", "minimum": -9007199254740990, "maximum": 9007199254740990 },
        "scope": { "enum": ["self", "own", "opponent", "all"] },
        "type": { "$ref": "urn:pokemon-tcg:card-definition:1.0.0#/$defs/pokemonType" },
        "activeOnly": { "type": "boolean" }, "sourceActive": { "type": "boolean" },
        "stages": { "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "urn:pokemon-tcg:card-definition:1.0.0#/$defs/pokemon/properties/stage" },
          "description": "Printed stage of each affected Pokémon, e.g. 「身上放有这张卡牌的【基础】宝可梦」「所有【2阶进化】宝可梦」." },
        "group": { "type": "string", "minLength": 1 },
        "targetSide": { "enum": ["own", "opponent", "all"] },
        "targetPosition": { "enum": ["active", "bench", "all"] },
        "damageFrom": { "enum": ["own", "opponent", "all"] },
        "targetSelector": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/affectedSelector" },
        "targetState": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/affectedState" },
        "otherSelector": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/otherSelector" },
        "otherState": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/otherState" },
        "attackIds": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/boostedAttacks" },
        "condition": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/continuousCondition" }
      },
      "allOf": [
        {
          "if": { "properties": { "field": { "enum": ["hp", "attackDamage", "defenseDamage"] } } },
          "then": { "properties": { "amount": { "type": "integer", "multipleOf": 10 } } }
        },
        {
          "if": { "anyOf": [
            { "required": ["targetSide"], "properties": { "targetSide": {} } },
            { "required": ["targetPosition"], "properties": { "targetPosition": {} } }
          ] },
          "then": { "properties": { "field": { "const": "attackDamage" } } }
        },
        { "if": { "required": ["damageFrom"], "properties": { "damageFrom": {} } }, "then": { "properties": { "field": { "const": "defenseDamage" } } } },
        { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/otherNeedsDamage" },
        { "if": { "required": ["attackIds"], "properties": { "attackIds": {} } }, "then": { "properties": { "field": { "const": "attackDamage" } } } }
      ]
    },
    "permissions": {
      "type": "object", "additionalProperties": false, "required": ["permissions"],
      "properties": {
        "permissions": { "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["first-turn-attack", "attack-while-asleep", "attack-while-paralyzed"] } }
      }
    },
    "protection": {
      "type": "object", "additionalProperties": false, "required": ["effect"],
      "properties": {
        "effect": { "allOf": [
          { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/continuous" },
          { "type": "object", "properties": { "op": { "const": "protection" } } }
        ] }
      }
    },
    "property": {
      "type": "object", "additionalProperties": false, "required": ["effect"],
      "properties": {
        "effect": { "allOf": [
          { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/continuous" },
          { "type": "object", "properties": { "op": { "const": "property" } } }
        ] }
      }
    },
    "damageOptions": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "ignoreWeakness": { "const": true }, "ignoreResistance": { "const": true },
        "ignoreDefenderEffects": { "const": true }, "applyBenchWeaknessResistance": { "const": true }
      }
    },
    "lasting": {
      "type": "object", "additionalProperties": false,
      "required": ["side", "target", "effect", "duration", "clearOnBench", "clearOnEvolution"],
      "properties": {
        "side": { "enum": ["own", "opponent"] }, "target": { "enum": ["any", "active", "self", "event", "attacker"] },
        "effect": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/lastingSpec" },
        "duration": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/duration" },
        "clearOnBench": { "type": "boolean" }, "clearOnEvolution": { "type": "boolean" }
      }
    },
    "damage": {
      "type": "object", "additionalProperties": false, "required": ["side", "target", "amount", "selection", "options"],
      "properties": {
        "rolls": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/damageRollPlans" },
        "side": { "enum": ["own", "opponent"] }, "target": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/target" },
        "targetSelector": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/affectedSelector" },
        "targetState": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/affectedState" },
        "amount": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/damageAmount" },
        "selection": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/damageSelection" },
        "options": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/damageOptions" }
      }
    },
    "restriction": {
      "type": "object", "additionalProperties": false, "required": ["effect"],
      "properties": { "effect": { "allOf": [
        { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/continuous" },
        { "type": "object", "properties": { "op": { "const": "restriction" } } }
      ] } }
    },
    "suppression": {
      "type": "object", "additionalProperties": false, "required": ["effect"],
      "properties": { "effect": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/suppression" } }
    },
    "playerRestriction": {
      "type": "object", "additionalProperties": false, "required": ["effect"],
      "properties": { "effect": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/playerRestriction" } }
    },
    "lastingPlayer": {
      "type": "object", "additionalProperties": false, "required": ["side", "effect", "duration"],
      "properties": {
        "side": { "enum": ["own", "opponent"] },
        "effect": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/playerOngoing/properties/effect" },
        "duration": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/duration" }
      },
      "allOf": [{ "if": { "properties": { "effect": { "type": "object", "properties": { "op": { "const": "modifier" } } } } },
        "then": { "properties": { "side": { "const": "own" } } } }]
    },
    "delayedReaction": {
      "type": "object", "additionalProperties": false,
      "required": ["side", "target", "trigger", "program", "duration", "clearOnBench", "clearOnEvolution"],
      "properties": {
        "side": { "enum": ["own", "opponent"] }, "target": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/target" },
        "trigger": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/reactionSpec/properties/trigger" },
        "program": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0" },
        "duration": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/duration" },
        "clearOnBench": { "type": "boolean" }, "clearOnEvolution": { "type": "boolean" }
      }
    },
    "transferCounters": {
      "type": "object", "additionalProperties": false, "required": ["count", "from", "side", "target"],
      "properties": {
        "count": { "type": "integer", "minimum": 1, "maximum": 900719925474099 },
        "from": { "enum": ["self", "any"] }, "side": { "enum": ["own", "opponent"] }, "target": { "enum": ["any", "active"] },
        "quantity": { "const": "upTo" }
      }
    },
    "attachDiscard": {
      "type": "object", "additionalProperties": false, "required": ["type", "count", "benchOnly", "optional"],
      "properties": {
        "type": {
          "description": "The named Basic Energy type, or null for any Basic Energy card.",
          "oneOf": [{ "$ref": "urn:pokemon-tcg:card-definition:1.0.0#/$defs/energyType" }, { "type": "null" }]
        },
        "count": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "benchOnly": { "type": "boolean" }, "optional": { "type": "boolean" },
        "target": { "const": "self", "description": "Attach only to this effect's own Pokémon (「附着于这只宝可梦身上」)." },
        "recipient": { "$ref": "urn:pokemon-tcg:energy-mechanics:1.0.0#/$defs/pokemonSelector", "description": "Printed in-play predicate of each recipient, e.g. a 「古代」 tag." },
        "distribution": {
          "enum": ["singleRecipient", "separateRecipients"],
          "description": "singleRecipient: all chosen cards go to one Pokémon (「附着于1只…身上」). separateRecipients: each Pokémon receives at most one (「各附着1张」). Absent: each card chooses freely."
        }
      },
      "allOf": [{
        "if": { "required": ["target"], "properties": { "target": {} } },
        "then": { "properties": { "benchOnly": { "const": false } } }
      }]
    }
  }
}
