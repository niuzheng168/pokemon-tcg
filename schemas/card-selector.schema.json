{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pokemon-tcg:card-selector:1.0.0",
  "title": "Reviewed out-of-play printed-card predicates, never UI text or current battle attributes",
  "oneOf": [
    { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "any" } } },
    { "$ref": "#/$defs/specific" },
    {
      "type": "object", "additionalProperties": false, "required": ["anyOf"],
      "properties": { "anyOf": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/specific" } } }
    }
  ],
  "$defs": {
    "names": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "urn:pokemon-tcg:card-definition:1.0.0#/$defs/id" }
    },
    "aceSpec": {
      "description": "「【ACE SPEC】」卡: whether the card is an ACE SPEC card (its printed 「在1副卡组中只能放入1张ACE SPEC卡」 deck group).",
      "type": "boolean"
    },
    "specific": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind"],
          "properties": {
            "kind": { "const": "pokemon" }, "prismStar": { "type": "boolean", "description": "Whether the card is a ◇ (Prism Star) card: false = 「（除◇（棱镜之星）外）」." }, "nameKeys": { "$ref": "#/$defs/names" }, "excludeNameKeys": { "$ref": "#/$defs/names" },
            "stages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "urn:pokemon-tcg:card-definition:1.0.0#/$defs/pokemon/properties/stage" } },
            "types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "urn:pokemon-tcg:card-definition:1.0.0#/$defs/pokemonType" } },
            "printedHpAtMost": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "printedRetreatCost": {
              "description": "「【撤退】所需能量为4个的宝可梦」「没有【撤退】所需能量的宝可梦」: the printed Retreat Cost, exactly this many Energy.",
              "type": "integer", "minimum": 0, "maximum": 9
            },
            "ruleBox": { "type": "boolean" }, "tagsAll": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "attackIds": { "$ref": "#/$defs/names" }, "abilityIds": { "$ref": "#/$defs/names" },
            "printedAbility": { "type": "boolean", "description": "Whether the card prints an Ability (including a VSTAR Power Ability): false = 「（除拥有特性的宝可梦外）」 for cards out of play. A Pokémon in play whose Abilities are in effect is PokemonState hasAbility." },
            "evolvesFromNameKeys": {
              "description": "「从「X」进化而来的（卡牌／宝可梦）」: a Pokémon card printed as evolving from one of these names.",
              "$ref": "#/$defs/names"
            },
            "attackNames": {
              "description": "「拥有招式「X」的宝可梦」: any Pokémon card printing an attack of exactly this name, whatever card it is on.",
              "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 }
            },
            "nameContains": { "type": "string", "minLength": 1 },
            "excludeTags": {
              "description": "「（除「宝可梦V・GX」外）」: no Pokémon having any of these tags.",
              "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 }
            },
            "excludeTypes": {
              "description": "「（除【无】宝可梦外）」: no Pokémon having any of these types (current types in play).",
              "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "urn:pokemon-tcg:card-definition:1.0.0#/$defs/pokemonType" }
            },
            "excludeNameContains": {
              "description": "「（除「火箭队的宝可梦」外）」: no card whose name contains this text.",
              "type": "string", "minLength": 1
            },
            "resistanceTypes": {
              "description": "「抗性为【斗】属性的宝可梦」: a Pokémon card printing a Resistance of one of these types (out of play; a Pokémon V-UNION card shows only its name and type there).",
              "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "urn:pokemon-tcg:card-definition:1.0.0#/$defs/pokemonType" }
            },
            "typesFrom": {
              "description": "selection.context 「与对手场上宝可梦／这只宝可梦身上附着的基本能量／被附着的能量相同属性的」: types read when the effect resolves, then matched as types (any of them). Its host resolves it; never with types.",
              "enum": ["opponentField", "attachedBasicEnergy", "eventEnergy"]
            },
            "namesFrom": {
              "description": "selection.context 「与对手场上宝可梦／自己弃牌区中的宝可梦名字相同的」: names read when the effect resolves, then matched as nameKeys. Its host resolves it; never with nameKeys.",
              "enum": ["opponentField", "ownDiscard"]
            }
          },
          "not": { "anyOf": [
            { "required": ["typesFrom", "types"], "properties": { "typesFrom": {}, "types": {} } },
            { "required": ["namesFrom", "nameKeys"], "properties": { "namesFrom": {}, "nameKeys": {} } }
          ] }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind"],
          "properties": {
            "kind": { "const": "trainer" }, "prismStar": { "type": "boolean", "description": "Whether the card is a ◇ (Prism Star) card: false = 「（除◇（棱镜之星）外）」." }, "nameKeys": { "$ref": "#/$defs/names" }, "excludeNameKeys": { "$ref": "#/$defs/names" },
            "categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["item", "supporter", "tool", "stadium"] } },
            "nameContains": { "type": "string", "minLength": 1 },
            "tagsAll": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "aceSpec": { "$ref": "#/$defs/aceSpec" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind"],
          "properties": {
            "kind": { "const": "energy" }, "prismStar": { "type": "boolean", "description": "Whether the card is a ◇ (Prism Star) card: false = 「（除◇（棱镜之星）外）」." }, "nameKeys": { "$ref": "#/$defs/names" }, "excludeNameKeys": { "$ref": "#/$defs/names" },
            "category": { "enum": ["basic", "special"] },
            "aceSpec": { "$ref": "#/$defs/aceSpec" },
            "tagsAll": { "description": "「「连击」卡」 on a Special Energy: every listed printed tag.", "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "types": {
              "description": "Named Basic Energy identities only. A Special Energy's attached provision is not its out-of-play card identity.",
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": { "$ref": "urn:pokemon-tcg:card-definition:1.0.0#/$defs/energyType" }
            }
          },
          "allOf": [{
            "if": { "required": ["types"], "properties": { "types": {} } },
            "then": { "required": ["category"], "properties": { "category": { "const": "basic" } } }
          }]
        }
      ]
    }
  }
}
