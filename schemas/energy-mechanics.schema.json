{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pokemon-tcg:energy-mechanics:1.0.0",
  "$defs": {
    "units": { "$ref": "urn:pokemon-tcg:card-definition:1.0.0#/$defs/energy/properties/baseUnits" },
    "energySelector": {
      "allOf": [
        { "$ref": "urn:pokemon-tcg:card-selector:1.0.0" },
        { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "energy" } } }
      ]
    },
    "pokemonSelector": {
      "description": "A Pokémon CardSelector, or printed alternatives of Pokémon (「宝可梦GX・EX」「ex或V」) as anyOf.",
      "oneOf": [
        { "allOf": [
          { "$ref": "urn:pokemon-tcg:card-selector:1.0.0" },
          { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "pokemon" } } }
        ] },
        { "type": "object", "additionalProperties": false, "required": ["anyOf"],
          "properties": { "anyOf": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "allOf": [
            { "$ref": "urn:pokemon-tcg:card-selector:1.0.0#/$defs/specific" },
            { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "pokemon" } } }
          ] } } } }
      ]
    },
    "requirement": {
      "type": "object", "additionalProperties": false, "required": ["op", "action", "mode", "scope"],
      "properties": {
        "op": { "const": "energyRequirement" }, "action": { "enum": ["attack", "retreat"] },
        "mode": { "enum": ["adjust", "erase", "replace", "reduceAny"], "description": "reduceAny: 「使用那个招式所需能量，减少N个。（减少的可以是任意属性的能量。）」 — count symbols of any types of the attack's cost (after every other change, on each alternative cost too) are removed; the attack can be used when some such reduced cost is met." },
        "scope": { "enum": ["self", "own", "opponent", "all"] },
        "count": { "type": "integer", "minimum": 1, "maximum": 10, "description": "reduceAny: how many symbols are removed." },
        "cost": { "type": "array", "maxItems": 10, "items": { "$ref": "urn:pokemon-tcg:card-definition:1.0.0#/$defs/energyType" },
          "description": "replace: 「这只宝可梦使用「X」所需能量，变为1个【无】能量」 — the listed attacks' printed cost becomes this cost (other changes then apply to it)." },
        "targetRemainingHpAtMost": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/remainingHpAtMost" },
        "energyType": { "$ref": "urn:pokemon-tcg:card-definition:1.0.0#/$defs/energyType", "description": "adjust: the type whose count changes. erase: only that type's part of the attack cost is erased (「这只宝可梦使用招式所需的无能量，全部消除」); absent = the whole cost." },
        "amount": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
        "perPrizesTaken": {
          "description": "The adjustment is amount × the Prize cards already taken by that side (II.D-17), e.g. 「减少与对手已经获得的奖赏卡张数相同数量的【无】能量」.",
          "enum": ["own", "opponent"]
        },
        "perCount": {
          "description": "The adjustment is amount × this count when the cost is checked: in-play Pokémon (「减少与对手备战宝可梦数量相同数量的【无】能量」) or cards in a zone, filtered by identity only in a public zone (「…与自己弃牌区中的「X」张数相同数量…」).",
          "oneOf": [
            { "$ref": "urn:pokemon-tcg:battle-value:1.0.0#/$defs/pokemonCount" },
            { "allOf": [
              { "$ref": "urn:pokemon-tcg:battle-value:1.0.0#/$defs/zoneCount" },
              { "if": { "type": "object", "required": ["selector"], "properties": { "selector": {} } }, "then": { "type": "object", "properties": { "zone": { "enum": ["discard", "lostZone"] } } } }
            ] }
          ]
        },
        "attackIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "type": { "$ref": "urn:pokemon-tcg:card-definition:1.0.0#/$defs/pokemonType" },
        "activeOnly": { "type": "boolean" }, "sourceActive": { "type": "boolean" },
        "stages": { "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "urn:pokemon-tcg:card-definition:1.0.0#/$defs/pokemon/properties/stage" },
          "description": "Printed stage of each affected Pokémon, e.g. 「自己所有【基础】宝可梦」." },
        "group": { "type": "string", "minLength": 1 },
        "targetSelector": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/affectedSelector" },
        "targetState": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/affectedState" },
        "condition": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/continuousCondition" }
      },
      "allOf": [
        { "if": { "properties": { "mode": { "const": "adjust" } } }, "then": {
          "required": ["energyType", "amount"], "properties": { "energyType": {}, "amount": {}, "action": { "const": "attack" } }
        }, "else": { "not": { "required": ["amount"], "properties": { "amount": {} } },
          "if": { "required": ["energyType"], "properties": { "energyType": {} } }, "then": { "properties": { "action": { "const": "attack" } } } } },
        { "if": { "required": ["attackIds"], "properties": { "attackIds": {} } }, "then": { "properties": { "action": { "const": "attack" } } } },
        { "if": { "properties": { "mode": { "const": "reduceAny" } } },
          "then": { "required": ["count"], "properties": { "count": {}, "action": { "const": "attack" } }, "not": { "required": ["energyType"], "properties": { "energyType": {} } } },
          "else": { "not": { "required": ["count"], "properties": { "count": {} } } } },
        { "if": { "properties": { "mode": { "const": "replace" } } },
          "then": { "required": ["cost", "attackIds"], "properties": { "cost": {}, "attackIds": {}, "action": { "const": "attack" } },
            "not": { "required": ["energyType"], "properties": { "energyType": {} } } },
          "else": { "not": { "required": ["cost"], "properties": { "cost": {} } } } },
        { "if": { "required": ["perPrizesTaken"], "properties": { "perPrizesTaken": {} } }, "then": { "properties": { "mode": { "const": "adjust" } } } },
        { "if": { "required": ["perCount"], "properties": { "perCount": {} } }, "then": {
          "properties": { "mode": { "const": "adjust" } }, "not": { "required": ["perPrizesTaken"], "properties": { "perPrizesTaken": {} } }
        } }
      ]
    },
    "provision": {
      "type": "object", "additionalProperties": false,
      "required": ["op", "scope", "selector", "cardSelf", "units"],
      "properties": {
        "op": { "const": "energyProvision" }, "scope": { "enum": ["self", "own", "opponent", "all"] },
        "selector": { "$ref": "#/$defs/energySelector" }, "cardSelf": { "type": "boolean" },
        "units": { "$ref": "#/$defs/units" },
        "type": { "$ref": "urn:pokemon-tcg:card-definition:1.0.0#/$defs/pokemonType" },
        "activeOnly": { "type": "boolean" }, "sourceActive": { "type": "boolean" },
        "stages": { "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "urn:pokemon-tcg:card-definition:1.0.0#/$defs/pokemon/properties/stage" },
          "description": "Printed stage of the Pokémon the Energy is attached to, e.g. 「如果被附着于2阶进化宝可梦身上的话」." },
        "otherAttached": {
          "description": "Applies only while the same Pokémon has another attached Energy card matching this selector, e.g. 「身上还附着了除这张卡牌以外的特殊能量的话」.",
          "$ref": "#/$defs/energySelector"
        },
        "targetSelector": {
          "description": "Only while attached to a Pokémon matching this selector (current types), e.g. 「如果被附着于「宝可梦V・GX」身上的话」, 「被附着于自己的宝可梦（除「宝可梦GX・EX」外）身上时」.",
          "$ref": "#/$defs/pokemonSelector"
        },
        "condition": {
          "description": "Only while this holds, read whenever the Energy is counted: Prize cards and other zone counts only (no Energy, HP or Pokémon state), e.g. 「如果自己的剩余奖赏卡张数比对手的剩余奖赏卡多的话」 → compare(zoneCount own prizes, gt, zoneCount opponent prizes).",
          "$ref": "urn:pokemon-tcg:battle-predicate:1.0.0"
        }
      }
    },
    "option": {
      "type": "object", "additionalProperties": false, "required": ["cost"],
      "properties": { "cost": { "type": "array", "items": { "$ref": "urn:pokemon-tcg:card-definition:1.0.0#/$defs/energyType" } } }
    },
    "attachedAction": {
      "type": "object", "additionalProperties": false,
      "required": ["op", "side", "from", "selector", "providedTypes", "measure", "quantity", "chooser"],
      "properties": {
        "op": { "enum": ["discardEnergy", "moveEnergy", "returnEnergy"] }, "side": { "enum": ["own", "opponent"] },
        "to": { "enum": ["hand", "deckShuffle", "deckTop", "deckBottom", "lost"], "description": "lost: 「放于放逐区」 (zones.lost-zone)." },
        "from": { "enum": ["self", "active", "bench", "any", "event", "attacker"] },
        "selector": { "$ref": "#/$defs/energySelector" },
        "providedTypes": { "oneOf": [
          { "type": "null" },
          { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "urn:pokemon-tcg:card-definition:1.0.0#/$defs/energyType" } }
        ] },
        "measure": { "enum": ["cards", "units"] }, "quantity": { "$ref": "urn:pokemon-tcg:effect-program:1.0.0#/$defs/cardQuantity" },
        "chooser": { "enum": ["source", "holder"] },
        "recipient": {
          "type": "object", "additionalProperties": false, "required": ["position", "selector"],
          "properties": {
            "position": { "enum": ["self", "active", "bench", "any"] },
            "selector": { "$ref": "#/$defs/pokemonSelector" }
          }
        },
        "distribution": { "enum": ["singleRecipient", "separateRecipients"] },
        "sameType": { "const": true, "description": "「【火】或【雷】属性中的1种属性的…基本能量」: every chosen card is a Basic Energy of one and the same type. With quantity all, 「所有【火】或者【雷】的基本能量」 (energy.same-type-all): every card of the one type the user chooses, none of the other." },
        "singleOrigin": { "const": true, "description": "「自己场上1只宝可梦身上附着的最多N个能量」: every chosen card comes from one and the same Pokémon." },
        "originSelector": { "$ref": "#/$defs/pokemonSelector", "description": "「附着于自己场上1只「TAG TEAM」宝可梦身上」: the Pokémon holding the cards must match (current types)." },
        "perPokemon": { "const": true, "description": "「（对手）所有宝可梦身上附着的能量各1个」: exactly one card from each Pokémon holding a matching card; quantity all." }
      },
      "allOf": [
        { "if": { "required": ["perPokemon"], "properties": { "perPokemon": {} } },
          "then": { "properties": { "measure": { "const": "cards" }, "quantity": { "type": "object", "properties": { "kind": { "const": "all" } } } },
            "not": { "anyOf": [{ "required": ["singleOrigin"], "properties": { "singleOrigin": {} } }, { "required": ["sameType"], "properties": { "sameType": {} } }] } } },
        { "if": { "required": ["sameType"], "properties": { "sameType": {} } },
          "then": { "properties": { "measure": { "const": "cards" }, "selector": { "type": "object", "required": ["category"], "properties": { "category": { "const": "basic" } } } } } },
        { "if": { "properties": { "op": { "const": "returnEnergy" } } },
          "then": { "required": ["to"], "properties": { "to": {} } },
          "else": { "not": { "required": ["to"], "properties": { "to": {} } } } },
        { "if": { "properties": { "op": { "const": "moveEnergy" } } }, "then": {
          "required": ["recipient", "distribution"], "properties": { "recipient": {}, "distribution": {} }
        }, "else": { "not": { "anyOf": [
          { "required": ["recipient"], "properties": { "recipient": {} } },
          { "required": ["distribution"], "properties": { "distribution": {} } }
        ] } } }
      ]
    },
    "plan": {
      "type": "object", "additionalProperties": false, "required": ["chosen", "assignments"],
      "properties": {
        "chosen": { "type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["instanceId", "originId"],
          "properties": { "instanceId": { "type": "string", "minLength": 1 }, "originId": { "type": "string", "minLength": 1 } }
        } },
        "assignments": { "type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["instanceId", "targetId"],
          "properties": { "instanceId": { "type": "string", "minLength": 1 }, "targetId": { "type": "string", "minLength": 1 } }
        } }
      }
    }
  }
}
