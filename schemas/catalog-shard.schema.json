{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pokemon-tcg:catalog-shard:2.0.0",
  "description": "Wire envelope only. After reference expansion EVERY definition/printing must pass the existing full card shape schema; selected records also pass executable, binding and independent release checks.",
  "type": "object", "additionalProperties": false, "required": ["schemaVersion", "shardId", "setCode", "sources", "definitions", "printings"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "shardId": { "$ref": "urn:pokemon-tcg:catalog-manifest:2.0.0#/$defs/setCode" },
    "setCode": { "$ref": "urn:pokemon-tcg:catalog-manifest:2.0.0#/$defs/setCode" },
    "sources": {
      "type": "object",
      "propertyNames": { "$ref": "urn:pokemon-tcg:card-definition:1.0.0#/$defs/id" },
      "additionalProperties": { "anyOf": [
        { "$ref": "urn:pokemon-tcg:card-definition:1.0.0#/$defs/evidence" },
        { "$ref": "urn:pokemon-tcg:card-definition:1.0.0#/$defs/libraryEvidence" }
      ] }
    },
    "definitions": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "printings": { "type": "array", "minItems": 1, "items": { "type": "object" } }
  }
}
