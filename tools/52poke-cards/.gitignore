.env.*
.venv/
__pycache__/
*.pyc
*.sqlite
*.sqlite-*
*.part
*.uploading
*.lock
*.zip
*.zip.sha256
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.avif
/downloads
/data
/images
/images-*
/official-candidates
/library
exports/
sources/current-access/*
!sources/current-access/wiki-robots-recheck.txt
sources/wiki-file-metadata/local-content-index.json
